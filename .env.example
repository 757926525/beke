# ==============================================================================
# 白狐博客 (WhiteFox Blog) 环境变量示例文件
# 在本地开发时重命名为 .env 或在云平台（Cloudflare Pages/腾讯云/阿里云/Docker）中直接配置
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心管理员与系统凭证 (Admin Credentials)
# ------------------------------------------------------------------------------
# Cloudflare Pages 服务端环境变量（推荐在 Cloudflare 控制台直接设定）：
ADMIN_USERNAME=fox
ADMIN_PASSWORD=whitefox2025
# 统一多设备同步房间名称（默认 whitefox-site-main）
SYNC_ROOM_KEY=whitefox-site-main

# 前端本地开发环境变量
VITE_ADMIN_USERNAME=fox
VITE_ADMIN_PASSWORD=whitefox2025

# 是否开启新用户注册 (true / false)
VITE_ALLOW_REGISTRATION=true

# ------------------------------------------------------------------------------
# 2. 邮箱注册与验证码自动回复服务 (SMTP Config)
# ------------------------------------------------------------------------------
# 是否开启邮箱注册
VITE_EMAIL_REGISTER_ENABLED=true
# 默认演示或静态自动回复验证码
VITE_EMAIL_VERIFY_CODE=668822
# SMTP 发信服务器 (如: smtp.qcloudmail.com, smtp.aliyun.com, smtp.qq.com, smtp.gmail.com)
VITE_SMTP_SERVER=smtp.qcloudmail.com
# SMTP 发信邮箱
VITE_SMTP_EMAIL=noreply@whitefox.blog
# SMTP 授权码 / 密码
VITE_SMTP_AUTH_KEY=your_smtp_auth_key_here

# ------------------------------------------------------------------------------
# 3. Cloudflare D1 分布式数据库配置 (Cloudflare D1 Database)
# ------------------------------------------------------------------------------
VITE_CF_D1_ENABLED=true
VITE_CF_ACCOUNT_ID=your_cloudflare_account_id
VITE_CF_D1_DATABASE_ID=your_d1_database_uuid
VITE_CF_API_TOKEN=your_cloudflare_api_token

# ------------------------------------------------------------------------------
# 4. Cloudflare R2 对象存储配置 (Cloudflare R2 Object Storage - S3 API)
# ------------------------------------------------------------------------------
VITE_CF_R2_ENABLED=true
VITE_CF_R2_BUCKET=whitefox-media
VITE_CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
VITE_CF_R2_CUSTOM_DOMAIN=https://media.whitefox.blog

# ------------------------------------------------------------------------------
# 5. 腾讯云 COS 对象存储配置 (Tencent Cloud COS)
# ------------------------------------------------------------------------------
VITE_TENCENT_COS_ENABLED=false
VITE_TENCENT_COS_SECRET_ID=your_tencent_secret_id
VITE_TENCENT_COS_SECRET_KEY=your_tencent_secret_key
VITE_TENCENT_COS_BUCKET=whitefox-cos-1250000000
VITE_TENCENT_COS_REGION=ap-guangzhou

# ------------------------------------------------------------------------------
# 6. 阿里云 OSS 对象存储配置 (Alibaba Cloud OSS)
# ------------------------------------------------------------------------------
VITE_ALIYUN_OSS_ENABLED=false
VITE_ALIYUN_OSS_ACCESS_KEY_ID=your_aliyun_access_key_id
VITE_ALIYUN_OSS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
VITE_ALIYUN_OSS_BUCKET=whitefox-oss-bucket
VITE_ALIYUN_OSS_REGION=oss-cn-hangzhou

# ------------------------------------------------------------------------------
# 7. 内置网盘与 WebDAV 配置 (AList / WebDAV / 百度网盘 / 夸克)
# ------------------------------------------------------------------------------
VITE_NETDRIVE_ENABLED=true
VITE_NETDRIVE_PROVIDER=AList / WebDAV
VITE_NETDRIVE_SERVER_URL=https://pan.whitefox.blog
VITE_NETDRIVE_TARGET_FOLDER=/白狐博客专存/媒体与电子书/
VITE_NETDRIVE_USERNAME=fox_admin
VITE_NETDRIVE_PASSWORD=your_netdrive_password
