# ==============================================================================
# 白狐博客 (WhiteFox Blog) 环境变量清单 (.env / Cloudflare Pages 后台配置)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 核心管理员凭据 (参数化配置，禁止硬编码)
# ------------------------------------------------------------------------------
VITE_SITE_NAME=fox
VITE_ADMIN_USERNAME=fox
VITE_ADMIN_PASSWORD=your_secure_password_2025
VITE_ALLOW_REGISTRATION=true

# ------------------------------------------------------------------------------
# 2. Cloudflare D1 边缘数据库配置 (D1 Database)
# ------------------------------------------------------------------------------
# 可在 Cloudflare Pages 设置中直接绑定 D1 Database (绑定变量名: DB)
# 或配置 REST API 专线直连:
VITE_CF_D1_ENABLED=true
VITE_CF_ACCOUNT_ID=your_cloudflare_account_id
VITE_CF_D1_DATABASE_ID=your_d1_database_uuid
VITE_CF_API_TOKEN=your_cloudflare_api_token

# ------------------------------------------------------------------------------
# 3. Cloudflare R2 对象存储配置 (R2 Object Storage & CORS)
# ------------------------------------------------------------------------------
# 可在 Cloudflare Pages 设置中直接绑定 R2 Bucket (绑定变量名: BUCKET)
# 或配置公网 CDN 访问域名与 S3 兼容凭据:
VITE_CF_R2_ENABLED=true
VITE_CF_R2_BUCKET=whitefox-media
VITE_CF_R2_ACCESS_KEY_ID=your_r2_access_key_id
VITE_CF_R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
VITE_CF_R2_CUSTOM_DOMAIN=https://media.whitefox.blog

# ------------------------------------------------------------------------------
# 4. 腾讯云 COS / 阿里云 OSS 对象存储 (国内 CDN 加速)
# ------------------------------------------------------------------------------
VITE_TENCENT_COS_BUCKET=whitefox-cos-1250000000
VITE_TENCENT_COS_SECRET_ID=your_tencent_secret_id
VITE_TENCENT_COS_SECRET_KEY=your_tencent_secret_key

VITE_ALIYUN_OSS_BUCKET=whitefox-oss-bucket
VITE_ALIYUN_OSS_ACCESS_KEY_ID=your_aliyun_access_key_id
VITE_ALIYUN_OSS_ACCESS_KEY_SECRET=your_aliyun_access_key_secret

# ------------------------------------------------------------------------------
# 5. 坚果云 / AList WebDAV 网盘配置
# ------------------------------------------------------------------------------
VITE_WEBDAV_SERVER=https://dav.jianguoyun.com/dav/
VITE_WEBDAV_USER=user@example.com
VITE_WEBDAV_APP_PASS=your_nutstore_app_password
